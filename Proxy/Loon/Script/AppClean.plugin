coolapk_enable = switch,true,false,tag=酷安 净化
amap_enable = switch,true,false,tag=高德 净化
tieba_enable = switch,true,false,tag=贴吧 净化
rednote_enable = switch,true,false,tag=小红书 净化
bdwp_enable = switch,true,false,tag=百度网盘 净化
p123_enable = switch,true,false,tag=123云盘 净化
unicom_enable = switch,true,false,tag=中国联通 净化

