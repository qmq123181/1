#!name=IPA Manager
#!desc=下载IPA文件实现降级应用安装、已购下架应用安装。 本插件依赖Scripting App且需解锁Pro权限。

[Script]
[IPA Manager]应用接口 = type=http-request, pattern=(?i)^https:\/\/apple-api\.com, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/loon_103516_xyz_applestoreapi.js, requires-body=true
[IPA Manager]应用安装 = type=http-request, pattern=(?i)^https:\/\/xiaobai\.app, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/loon_103516_xyz_installapp.js

[MITM]
hostname = %APPEND% apple-api.com, xiaobai.app

