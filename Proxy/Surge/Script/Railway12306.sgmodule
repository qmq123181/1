#!name=铁路12306
#!desc=过滤铁路12306广告

[Rule]
DOMAIN,ad.12306.cn,DIRECT

[Script]
[铁路12306]移除开屏广告 = type=http-request, pattern=(?i)^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/kokoryh_sparkle_12306.js, requires-body=true
[铁路12306]移除应用内广告 = type=http-request, pattern=(?i)^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/kokoryh_sparkle_12306.js

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn

