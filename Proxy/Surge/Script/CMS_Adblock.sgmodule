#!name=CMS Adblocker
#!desc=过滤CMS资源插入式广告

[URL Rewrite]
(?i)(^https?:\/\/s\d+\.bfengbf\.com\/video)(.+)_z5q\.ts $1$2.ts 307

[Script]
[CMS]黑木耳 = type=http-response, pattern=(?i)^https?:\/\/m3u8\.(hmrvideo|heimuertv)\.com\/play\/(.+).m3u8, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/yswag_for-own-use_cmsadblock.js, requires-body=true, timeout=30
