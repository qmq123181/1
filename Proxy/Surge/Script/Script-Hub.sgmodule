#!name=Script-Hub
#!desc=把 Rewrite、Rule 和 JavaScript 资源转换成 Surge 可识别的格式。

[Script]
前端界面 = type=http-request, pattern=(?i)^https?:\/\/script\.hub\/($|edit\/|reload), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/script-hub-org_script-hub_script-hub.js, timeout=300
Rewrite转换 = type=http-request, pattern=(?i)^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/script-hub-org_script-hub_rewrite-parser.js, timeout=300
Rule转换 = type=http-request, pattern=(?i)^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/script-hub-org_script-hub_rule-parser.js, timeout=300
JavaScript转换 = type=http-request, pattern=(?i)^https?:\/\/script\.hub\/convert\/, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/script-hub-org_script-hub_script-converter.js, timeout=300

[MITM]
hostname = %APPEND% script.hub, *.script.hub

[Rule]

