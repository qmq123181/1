#!name=Nicegram Premium 𝕏
#!desc=Nicegram 去广告并解除学习探索限制。

[Rule]
DOMAIN,static-cf.nicegram.app,REJECT
DOMAIN,image.adsgram.me,REJECT
DOMAIN,api.adsgram.ai,REJECT
DOMAIN,relay.walletconnect.com,REJECT
DOMAIN,verify.walletconnect.org,REJECT
DOMAIN,firebaseremoteconfig.googleapis.com,REJECT
DOMAIN,firebase-settings.crashlytics.com,REJECT
DOMAIN,firebaseinstallations.googleapis.com,REJECT

[Script]
Nicegram Premium 𝕏 = type=http-response, pattern=^https?:\/\/nicegram\.cloud\/api\/v\d+\/(ai-assistant\/purchase-list|telegram\/auth|user\/info|unblock-feature|adsgram\/get-banner|att\/scroll-to-earn\/user-info|att\/scroll-to-earn\/config|att\/scroll-to-earn\/ads-list|airdrop\/task-list), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/he2o_vercel_app_nicegram.js, requires-body=true, timeout=60, argument=attPoints="9999"&gems="9999"

[MITM]
hostname = %APPEND% nicegram.cloud

