#!name=Sub-Store
#!desc=Sub-Store 订阅管理工具，定时任务每天 23:55。

[Script]
Sub-Store Core = type=http-request, pattern=(?i)^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/sub-store-org_sub-store_sub-store-1.min_53973a.js, requires-body=true, timeout=120
Sub-Store Simple = type=http-request, pattern=(?i)^https?:\/\/sub\.store, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/sub-store-org_sub-store_sub-store-0.min.js, requires-body=true, timeout=120
Sub-Store Sync = type=cron, cronexp="55 23 * * *", script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/sub-store-org_sub-store_cron-sync-artifacts.min_2d4444.js, timeout=120

[MITM]
hostname = %APPEND% sub.store

[Rule]

