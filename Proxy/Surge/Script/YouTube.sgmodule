#!name=YouTube (Music)
#!desc=过滤YouTube (Music)广告，增加画中画、字幕翻译、歌词翻译功能，支持后台播放。需要启用QUIC回退保护。不支持tvOS设备。

[Rule]

[URL Rewrite]

[Map Local]

[Script]
[YouTube]response = type=http-response, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/maasea_sgmodule_youtube.response.js, requires-body=true, binary-body-mode=true, argument=captionLang="off"&blockUpload="true"&blockImmersive="true"&blockShorts="true"&debug="false"
[YouTube]request_init = type=http-request, pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/maasea_sgmodule_youtube.request.js, requires-body=true, binary-body-mode=true, argument=captionLang="off"
[YouTube]request_log_event = type=http-request, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/maasea_sgmodule_youtube.request.js, requires-body=true, binary-body-mode=true

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com

