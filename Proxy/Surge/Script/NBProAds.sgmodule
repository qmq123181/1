#!name=qx_nbproads
#!desc=过滤 nbpro 系列 App 的开屏与信息流广告。

[Rule]
DOMAIN,capsinfo.anythink.com,REJECT
DOMAIN,showtime.anythink.com,REJECT
DOMAIN,pitk.birdgesdk.com,REJECT
DOMAIN,aa.birdgesdk.com,REJECT
DOMAIN,fusion-static.oss-cn-shenzhen.aliyuncs.com,REJECT
DOMAIN,cpu-openapi.baidu.com,REJECT
DOMAIN,mobads-pre-config.bj.bcebos.com,REJECT
DOMAIN,render-server.cdn.bcebos.com,REJECT
DOMAIN,api.htp.ad-scope.com.cn,REJECT
DOMAIN,bid.ad-scope.com.cn,REJECT
DOMAIN,sdk.beizi.biz,REJECT
DOMAIN,sdktmp.hubcloud.com.cn,REJECT
DOMAIN,api-cfg.8ziben.com,REJECT
DOMAIN,api-incentive.8ziben.com,REJECT
DOMAIN,static.8ziben.com,REJECT
DOMAIN,c.etoolads.cn,REJECT
DOMAIN,open.e.kuaishou.cn,REJECT

[Script]
nbpro.ads = type=http-response, pattern=^https?:\/\/(?:nbtool8\.com(?::(?:9527|9666))?|124\.222\.32\.246(?::9527)?|117\.72\.39\.157(?::9527)?|cesapp\.goypzc\.cn(?::9527)?|47\.243\.71\.210(?::9527)?)\/nb\/app(?:\?.*)?$, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/ddgksf2013_top_nbpro.ads.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% nbtool8.com, cesapp.goypzc.cn, 124.222.32.246, 117.72.39.157, 47.243.71.210

