#!name=墨鱼手记页一键添加插件
#!desc=Loon 网页资源订阅转换页，用于一键生成插件链接。

[General]
force-http-engine-hosts = %APPEND% script.hub, *.script.hub

[Rule]
AND,((DOMAIN-SUFFIX,ddgksf2013.top),(PROTOCOL,QUIC)),REJECT

[Script]
网页变身 = type=http-response, pattern=^https?:\/\/ddgksf2013.top\/$, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/ddgksf2013_top_web.loon.js, timeout=300
脚本转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/script-hub-org_script-hub_rewrite-parser.js, timeout=300

[MITM]
hostname = %APPEND% script.hub, *.script.hub, ddgksf2013.top

