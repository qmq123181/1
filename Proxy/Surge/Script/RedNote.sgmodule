#!name=小红书
#!desc=过滤小红书广告，去除水印

[Rule]
DOMAIN,ads-img-al.xhscdn.com,REJECT
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,t-ads.xiaohongshu.com,REJECT
AND,((PROTOCOL,QUIC),(OR,((DOMAIN-SUFFIX,xiaohongshu.com),(DOMAIN-SUFFIX,rnote.com)))),REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/search\/banner_list$ 'if ((getpath([]) // {}) | has("data")) then (setpath(["data"]; "{}")) else . end'
http-response-jq (?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/search\/hot_list$ 'if ((getpath(["data"]) // {}) | has("items")) then (setpath(["data","items"]; "[]")) else . end'
http-response-jq (?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/search\/hint 'if ((getpath(["data"]) // {}) | has("hint_words")) then (setpath(["data","hint_words"]; "[]")) else . end'
http-response-jq (?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/search\/trending\? 'if ((getpath(["data"]) // {}) | has("queries")) then (setpath(["data","queries"]; "[]")) else . end'
http-response-jq (?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/search\/trending\? 'if ((getpath(["data"]) // {}) | has("hint_word")) then (setpath(["data","hint_word"]; "{}")) else . end'

[Map Local]
(?i)^https?:\/\/ci\.(?:xiaohongshu|rnote)\.com\/system_config\/watermark data-type=tiny-gif status-code=200
(?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/www\.(?:xiaohongshu|rnote)\.com\/api\/marketing\/box\/trigger\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(?:guide\/user_banner|note\/guide) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/www\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(?:ads\/resource|hey\/\w+\/hey_gallery) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
[小红书]移除整体配置 ui = type=http-response, pattern=(?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/system\/service\/ui\/config\?, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除开屏广告 config = type=http-response, pattern=(?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/system_service\/config\?, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除开屏广告 splash_config = type=http-response, pattern=(?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v2\/system_service\/splash_config, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除详情页小部件、关注页感兴趣的人 = type=http-response, pattern=(?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除详情页感兴趣的人 = type=http-response, pattern=(?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]首页笔记标题前显示时间 = type=http-response, pattern=(?i)^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v6\/homefeed\?, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/loon_103516_xyz_rednote.feedtime.js, requires-body=true
[小红书]移除信息流广告 = type=http-response, pattern=(?i)^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/followfeed\?, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除信息流广告 = type=http-response, pattern=(?i)^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v6\/homefeed\?, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除搜索页广告 = type=http-response, pattern=(?i)^https:\/\/(?:edith|so)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v10\/search\/notes\?, script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除图片和实况照片水印 = type=http-response, pattern=(?i)^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除图片和视频水印 = type=http-response, pattern=(?i)^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除视频水印 = type=http-response, pattern=(?i)^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/rucu6_pages_dev_xiaohongshu.js, requires-body=true
[小红书]移除评论区实况照片水印 = type=http-response, pattern=(?i)^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list|v3\/note\/comment\/sub_comments), script-path=https://raw.githubusercontent.com/qmq123181/1/main/copy/js/fmz200_wool_scripts_xiaohongshu.js, requires-body=true

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, www.xiaohongshu.com, so.xiaohongshu.com

